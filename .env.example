# Neon Postgres connection string (Vercel Marketplace → Neon, personal account)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# One secret per trust boundary. Generate each with: openssl rand -hex 32
# MCP bearer for Claude Code + password for the OAuth /authorize step (claude.ai).
MCP_SECRET=replace-with-a-long-random-hex-string
# Bearer that Health Auto Export sends to /api/ingest. While unset, MCP_SECRET is
# accepted for ingest so an existing setup keeps working until you switch the header.
INGEST_SECRET=replace-with-a-different-random-hex-string
# Browser login password for the dashboard (/login) and HMAC key of the session cookie.
COACH_WEB_SECRET=replace-with-another-random-hex-string
# HEVY API key (HEVY app → Settings → Developer). Read-only use: the server never writes to HEVY.
HEVY_API_KEY=
# Bearer Vercel Cron sends to /api/hevy/sync. Set it in Vercel as CRON_SECRET; while
# unset, MCP_SECRET also triggers the sync by hand.
CRON_SECRET=
# "true" registers the coach write tools on the MCP endpoint; anything else hides them.
COACH_ENABLED=false
